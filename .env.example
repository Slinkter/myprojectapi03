# ==============================================================================
# Rick and Morty Explorer — Variables de Entorno y Configuración
# ==============================================================================
# Copia este archivo a `.env` en la raíz del proyecto:
#   cp .env.example .env
# NUNCA subas tu archivo `.env` al repositorio de Git.

# URL base de la API oficial de Rick and Morty
# Servicio público y gratuito (https://rickandmortyapi.com)
# NO requiere registro ni clave de API.
VITE_API_BASE_URL=https://rickandmortyapi.com/api

# Entorno de la aplicación (development | production | test)
VITE_APP_ENV=development

# Feature Flags de Diagnóstico y Rendimiento
# Habilitar logs en consola durante el desarrollo (true | false)
VITE_ENABLE_LOGGER=false

# Habilitar integración con Redux DevTools (true | false)
VITE_ENABLE_REDUX_DEVTOOLS=false

# NOTA SOBRE CREDENCIALES:
# La API The Rick and Morty API es de acceso público sin autenticación.
# Puedes realizar consultas a personajes, ubicaciones y episodios sin tokens ni cuotas restrictivas.
